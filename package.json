{
  "name": "code-graph-explorer",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-wasm.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "vitest run src",
    "test:browser": "npm run build && playwright test",
    "test:claims": "npm run build && playwright test tests/claims.spec.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.58.2",
    "axe-core": "^4.13.0",
    "tree-sitter-wasms": "^0.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "web-tree-sitter": "^0.20.8"
  },
  "dependencies": {
    "tree-sitter-wasms": "^0.1.13"
  }
}
